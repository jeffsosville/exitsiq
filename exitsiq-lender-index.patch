+const LO=Math.log10(8), HI=Math.log10(900);
+D.forEach(d=>{
+  if(d.av===null||d.av===undefined){ d.share=null; d.agg=null; d.cm=null; d.dp=null; d.tk=null; return; }
+  d.share = d.v>0 ? (d.av/d.v)*100 : 0;
+  d.cm = Math.min(d.share/55,1)*55;
+  d.dp = d.av<=0 ? 0 : Math.max(0,Math.min(1,(Math.log10(d.av)-LO)/(HI-LO)))*45;
