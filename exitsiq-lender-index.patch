+    const x=X(v);
+    g+=`<line x1="${x.toFixed(1)}" y1="${PT}" x2="${x.toFixed(1)}" y2="${H-PB}" stroke="#1b2b26" stroke-width="1"/>`;
+    g+=`<text x="${x.toFixed(1)}" y="${H-PB+20}" text-anchor="middle" class="q-note">${v>=1000?"$"+v/1000+"B":"$"+v+"M"}</text>`;
+  });
+  g+=`<text x="${PL}" y="${H-6}" class="q-note">Total 7(a) volume, FY2025 &rarr;</text>`;
+  g+=`<text x="${W-PR-18}" y="${Y(15)-10}" text-anchor="end" class="q-note" fill="#546b63">below this line, acquisitions are incidental</text>`;
+
+  D.filter(d=>d.share!==null).forEach(d=>{
+    const s=d.share, x=X(d.v), y=Y(s);
+    const rad = 3.6+Math.sqrt(d.av||1)/5.4;
+    g+=`<circle class="pt" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${rad.toFixed(1)}" fill="${rampColor(s)}" fill-opacity=".85" data-r="${d.r}"><title>${d.n.replace(/&amp;/g,"&")} — ${s.toFixed(0)}% acquisition · ${fmtM(d.av)} of ${fmtM(d.v)}</title></circle>`;
+  });
+
+  const lbl=[
+    ["Live Oak",-11,4,"end"],
+    ["The Huntington",-11,17,"end"],
+    ["First Internet",0,-15,"middle"],
+    ["GBank",0,19,"middle"],
+    ["Byline Bank",12,4,"start"],
+    ["Truliant",0,-15,"middle"],
+    ["Pathward",-10,4,"end"],
+    ["Northeast Bank",0,-14,"middle"],
+    ["JPMorgan Chase",0,-14,"middle"]
+  ];
+  lbl.forEach(([nm,dx,dy,anc])=>{
+    const d=D.find(z=>z.n.indexOf(nm)===0);
+    if(!d||d.share===null)return;
+    g+=`<text x="${(X(d.v)+dx).toFixed(1)}" y="${(Y(d.share)+dy).toFixed(1)}" text-anchor="${anc}" class="q-note" fill="#aab9b2" style="font-size:10px">${nm}</text>`;
+  });
+  svg.innerHTML=g;
+  svg.addEventListener("click",e=>{
+    const c=e.target.closest(".pt"); if(!c)return;
+    const r=+c.getAttribute("data-r");
+    document.getElementById("q").value="";
+    state.q=""; state.f="all"; syncSeg(); render();
+    const row=document.querySelector(`tr[data-r="${r}"]`);
+    if(row){ toggle(row); row.scrollIntoView({block:"center",behavior:"smooth"}); }
+  });
+})();
+
+/* ---------- table ---------- */
+const tb=document.getElementById("tb"), cnt=document.getElementById("count");
+const state={k:"agg",dir:"desc",f:"all",q:""};
+
+function passes(d){
+  if(state.q){
+    const s=(d.n+" "+d.hq).toLowerCase().replace(/&amp;/g,"&");
+    if(s.indexOf(state.q)<0) return false;
+  }
+  const t=tierOf(d).k;
+  if(state.f==="led")    return t==="led";
+  if(state.f==="active") return t==="active";
+  if(state.f==="eta")    return d.tags.includes("eta");
+  if(state.f==="avoid")  return d.tags.includes("avoid");
+  return true;
+}
+function sortRows(rows){
+  const k=state.k, m=state.dir==="desc"?-1:1;
+  return rows.sort((a,b)=>{
+    if(k==="n") return a.n.localeCompare(b.n)*(state.dir==="desc"?-1:1);
+    const av=a[k], bv=b[k];
+    if(av===null||av===undefined) return 1;
+    if(bv===null||bv===undefined) return -1;
+    return (av-bv)*m;
+  });
+}
+function render(){
+  const rows=sortRows(D.filter(passes));
+  cnt.textContent=rows.length+" of 100 lenders";
+  tb.innerHTML=rows.map((d,i)=>{
+    const t=tierOf(d);
+    const sc = d.agg===null
+      ? `<span class="na">no data</span>`
+      : `<span class="score"><span class="score-n">${d.agg.toFixed(0)}</span><span class="score-b"><i style="width:${d.agg.toFixed(0)}%;background:${rampColor(d.share)}"></i></span></span>`;
+    const sh = d.share===null
+      ? `<span class="na">&mdash;</span>`
+      : `<span class="sh"><b>${d.share.toFixed(0)}</b>%</span>`;
+    return `<tr data-r="${d.r}">
+      <td class="l rank">${state.k==="agg"?(i+1):"#"+d.r}</td>
+      <td class="l"><div class="lname">${d.n}</div><div class="lhq">${d.hq} &middot; <span style="color:${t.c}">${t.l}</span></div></td>
+      <td>${sc}</td>
+      <td>${sh}</td>
+      <td>${d.av===null?'<span class="na">&mdash;</span>':fmtM(d.av)}</td>
+      <td>${d.al===null?'<span class="na">&mdash;</span>':d.al.toLocaleString()}</td>
+      <td>${d.tk===null?'<span class="na">&mdash;</span>':fmtK(d.tk)}</td>
+      <td>${fmtM(d.v)}</td>
+      <td>${d.l.toLocaleString()}</td>
+      <td>${d.rate.toFixed(2)}%</td>
+    </tr>`;
+  }).join("");
+}
+function toggle(row){
+  const r=+row.getAttribute("data-r");
+  const nx=row.nextElementSibling;
+  if(nx&&nx.classList.contains("detail")){ nx.remove(); row.classList.remove("open"); return; }
+  document.querySelectorAll("tr.detail").forEach(x=>x.remove());
+  document.querySelectorAll("tr.open").forEach(x=>x.classList.remove("open"));
+  const d=D.find(z=>z.r===r);
+  const math = d.agg===null
+    ? `<div class="math"><div><span>Acquisition data</span><b>not published</b></div><span class="noteblk">None of the four public FOIA re-publishers reviewed break out a change-of-ownership figure for this lender. Absence of data is not evidence of absent appetite &mdash; it means this lender has to be diligenced by phone.</span></div>`
+    : `<div class="math">
+        <div><span>Acquisition share</span><b>${d.share.toFixed(1)}%</b></div>
+        <div><span>Commitment &middot; 55 max</span><b>${d.cm.toFixed(1)}</b></div>
+        <div><span>Depth &middot; 45 max</span><b>${d.dp.toFixed(1)}</b></div>
+        <div class="tot"><span>Aggressiveness</span><b>${d.agg.toFixed(1)} / 100</b></div>
+      </div>`;
+  const tr=document.createElement("tr");
+  tr.className="detail";
+  tr.innerHTML=`<td colspan="10"><div class="dt">
+    <div>
+      <h4>Structure &amp; appetite</h4>
+      <p>${d.note}</p>
+      <div class="tags">${d.flags.map(f=>`<span class="tag ${f[0]}">${f[1]}</span>`).join("")}</div>
+    </div>
+    <div><h4>Score derivation</h4>${math}</div>
+  </div></td>`;
+  row.after(tr);
+  row.classList.add("open");
+}
+
+tb.addEventListener("click",e=>{
+  const row=e.target.closest("tr");
+  if(!row||row.classList.contains("detail"))return;
+  toggle(row);
+});
+document.querySelectorAll("thead th").forEach(th=>{
+  const k=th.getAttribute("data-k"); if(!k)return;
+  th.addEventListener("click",()=>{
+    if(state.k===k){ state.dir=state.dir==="desc"?"asc":"desc"; }
+    else{ state.k=k; state.dir=(k==="n")?"asc":"desc"; }
+    document.querySelectorAll("thead th").forEach(x=>{x.removeAttribute("aria-sort");const a=x.querySelector(".ar");if(a)a.textContent="";});
+    th.setAttribute("aria-sort",state.dir==="desc"?"descending":"ascending");
+    const ar=th.querySelector(".ar"); if(ar) ar.textContent=state.dir==="desc"?"▼":"▲";
+    render();
+  });
+});
+function syncSeg(){
+  document.querySelectorAll(".seg button").forEach(b=>
+    b.setAttribute("aria-pressed", b.getAttribute("data-f")===state.f ? "true":"false"));
+}
+document.querySelectorAll(".seg button").forEach(b=>{
+  b.addEventListener("click",()=>{ state.f=b.getAttribute("data-f"); syncSeg(); render(); });
+});
+document.getElementById("q").addEventListener("input",e=>{
+  state.q=e.target.value.trim().toLowerCase(); render();
+});
+
+/* pin the column header directly below the nav + control bar, whatever they measure */
+function syncSticky(){
+  const nav=document.querySelector("nav");
+  const bar=document.querySelector(".controls");
+  if(!bar||!nav) return;
+  if(getComputedStyle(bar).position!=="sticky"){
+    document.querySelectorAll("thead th").forEach(th=>{th.style.top="";});
+    return;
+  }
+  const navH=nav.getBoundingClientRect().height;
+  bar.style.top=navH+"px";
+  const top=navH+bar.getBoundingClientRect().height;
+  document.querySelectorAll("thead th").forEach(th=>{ th.style.top=top+"px"; });
+}
+window.addEventListener("resize",syncSticky);
+syncSticky();
+render();
+</script>
+</body>
+</html>
